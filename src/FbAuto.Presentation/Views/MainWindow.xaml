<Window x:Class="FbAuto.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FbAuto.Core.Models;assembly=FbAuto.Core"
        mc:Ignorable="d"
        Title="自动化工具_Facebook"
        Width="1176" Height="752" MinWidth="1120" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource Brush.Window}">

    <!-- 三栏宽度按界面还原版写死：左 240 / 中 400 / 右 520 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <TextBlock Text="自动化工具_Facebook" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="浏览器：" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,6,0" />
                    <ComboBox Width="152" ItemsSource="{Binding Browsers}" SelectedIndex="0"
                              IsEnabled="{Binding IsBrowserListReady}" />
                    <Button Content="打开浏览器" Style="{StaticResource SecondaryButton}" Height="26"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="520" />
            </Grid.ColumnDefinitions>

            <!-- ==================== 左栏：任务类型 ==================== -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="38" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="任务类型（点击添加）" VerticalAlignment="Center" Margin="14,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,8,8,8">
                        <ItemsControl ItemsSource="{Binding TaskTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TaskTypeButton}"
                                            Content="{Binding DisplayName}"
                                            Margin="0,0,0,2"
                                            Command="{Binding DataContext.AddTaskCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ==================== 中栏：任务队列 ==================== -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="38" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="状态" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="任务" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Grid.Column="2" Text="浏览器" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Grid.Column="3" Text="结果" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                        </Grid>
                    </Border>

                    <Grid>
                        <ListBox ItemsSource="{Binding Tasks}"
                                 SelectedItem="{Binding SelectedTask}"
                                 ItemContainerStyle="{StaticResource QueueItem}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="42" Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Left"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskRunStatus.Running}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Info}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskRunStatus.Success}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskRunStatus.Failed}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskRunStatus.Paused}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskRunStatus.Interrupted}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding BrowserName}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Result}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空态：文案取自原版界面串 -->
                        <TextBlock Text="暂无任务，请从左侧添加" Margin="14,0,0,16"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource Brush.TextMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ==================== 右栏：参数面板 ==================== -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Surface}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Height="54" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                            <Button Content="开始任务" Style="{StaticResource PrimaryButton}" Width="86" Height="30"
                                    Command="{Binding StartTasksCommand}" />
                            <Button Content="停止任务" Style="{StaticResource SecondaryButton}" Width="86" Height="30"
                                    Margin="8,0,0,0" Command="{Binding StopTasksCommand}" />
                            <Button Content="删除任务" Style="{StaticResource SecondaryButton}" Width="86" Height="30"
                                    Margin="8,0,0,0" Command="{Binding RemoveTaskCommand}" />
                            <TextBlock Text="{Binding TaskSummary}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TabControl Style="{StaticResource PanelTabControl}">

                        <!-- ==== 视频上传 ==== -->
                        <TabItem Header="视频上传">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="视频路径：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding VideoDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="选择..." Style="{StaticResource SecondaryButton}"
                                                Width="62" Height="26" Margin="6,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="视频描述：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding DescriptionFile, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="选择..." Style="{StaticResource SecondaryButton}"
                                                Width="62" Height="26" Margin="6,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="保存目录：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="选择..." Style="{StaticResource SecondaryButton}"
                                                Width="62" Height="26" Margin="6,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="并发数：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                                 Text="{Binding ConcurrentCount, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="启动间隔：" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBox Width="60" Text="{Binding BrowserOpenIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="秒" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="浏览器类型：" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Column="1" Width="110" ItemsSource="{Binding BrowserTypes}"
                                                  SelectedItem="{Binding BrowserType}" />
                                        <TextBlock Grid.Column="2" Text="起始小时：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="3" Width="60" HorizontalAlignment="Left"
                                                 Text="{Binding ScheduledStartHour, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="定时发布：" Style="{StaticResource FieldLabel}" />
                                        <DatePicker Grid.Column="1" HorizontalAlignment="Left" Width="160" Height="26"
                                                    SelectedDate="{Binding ScheduledDate}" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,6,0,10" />

                                    <TextBlock Text="公共主页发帖设置：主页名称 · 个性签名 · 密码 · 头像 · 评论区屏蔽词"
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="密码与凭据不在界面明文保存，只存 cred:// 引用（与原版的差异点）"
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ==== 资料修改 ==== -->
                        <TabItem Header="资料修改">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="主页名称：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" IsEnabled="False" Text="S5 阶段接入" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="个性签名：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" IsEnabled="False" Text="S5 阶段接入" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="密码：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" IsEnabled="False" Text="通过 cred:// 引用，不落明文" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="头像：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" IsEnabled="False" Text="S5 阶段接入" />
                                        <Button Grid.Column="2" Content="选择..." Style="{StaticResource SecondaryButton}"
                                                Width="62" Height="26" Margin="6,0,0,0" IsEnabled="False" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="背景图：" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" IsEnabled="False" Text="S5 阶段接入" />
                                        <Button Grid.Column="2" Content="选择..." Style="{StaticResource SecondaryButton}"
                                                Width="62" Height="26" Margin="6,0,0,0" IsEnabled="False" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ==== 删除消息 ==== -->
                        <TabItem Header="删除消息">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,10">
                                <StackPanel>
                                    <TextBlock Text="屏蔽词（逗号分隔，命中即删）：" Style="{StaticResource FieldLabel}"
                                               HorizontalAlignment="Left" Margin="0,0,0,6" />
                                    <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             Text="{Binding MessageBlockWords, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="默认与原版一致：.com,https,pn,dn,inbox"
                                               Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
